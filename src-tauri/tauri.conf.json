{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "IslandX",
  "version": "../package.json",
  "identifier": "com.islandx.overlay",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "IslandX",
      "width": 186,
      "height": 36,
      "transparent": true,
      "decorations": false,
      "alwaysOnTop": true,
      "skipTaskbar": true,
      "resizable": false,
      "shadow": false,
      "focus": false,
      "visible": false
    }],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-ancestors 'none'" }
  },
  "plugins": {
    "updater": { "pubkey": "", "endpoints": [] }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": ["icons/icon.ico"],
    "windows": {
      "nsis": { "installMode": "currentUser", "installerHooks": "installer/hooks.nsh" }
    }
  }
}
